generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AppLocale {
  AZ
  EN
  RU
}

enum TeamRole {
  OWNER
  CAPTAIN
  MEMBER
}

enum ClubVisibility {
  OPEN
  REQUEST_ONLY
  INVITE_ONLY
}

enum ClubRole {
  OWNER
  TD
  YTD
  PLAYER
}

enum ClubMemberStatus {
  ACTIVE
  INVITED
  REQUESTED
  LEFT
  REMOVED
}

enum ClubPermissionPolicy {
  OWNER_ONLY
  OWNER_TD
  OWNER_TD_YTD
}

enum GuestInvitePolicy {
  CLOSED
  ONLY_OWNER_TD_YTD
  PLAYERS_CAN_INVITE_FRIENDS
}

enum MatchStatus {
  DRAFT
  PENDING
  ACCEPTED
  REJECTED
  SCHEDULED
  LIVE
  RESULT_PENDING
  COMPLETED
  DISPUTED
  CANCELLED
  // Legacy values are retained because this project synchronizes with db push.
  PENDING_OPPONENT_APPROVAL
  RESULT_PENDING_CONFIRMATION
  FINISHED
}

enum MatchType {
  INTERNAL
  CLUB_VS_CLUB
}

enum MatchSource {
  MANUAL
  TOURNAMENT
  LEAGUE
}

enum MatchFormat {
  FIVE_V_FIVE
  SIX_V_SIX
  SEVEN_V_SEVEN
  EIGHT_V_EIGHT
  NINE_V_NINE
  ELEVEN_V_ELEVEN
}

enum MatchCategory {
  FRIENDLY
  TRAINING
  OFFICIAL
}

enum MatchSideType {
  HOME
  AWAY
  TEAM_A
  TEAM_B
}

enum MatchPlayerStatus {
  SELECTED
  INVITED
  ACCEPTED
  DECLINED
  MAYBE
  REMOVED
}

enum MatchLineupRole {
  STARTER
  SUBSTITUTE
}

enum MatchCancellationReason {
  PLAYER_SHORTAGE
  VENUE_PROBLEM
  DATE_UNAVAILABLE
  WEATHER
  MUTUAL_AGREEMENT
  OTHER
}

enum FootballPosition {
  GK
  CB
  LB
  RB
  LWB
  RWB
  CDM
  CM
  CAM
  LM
  RM
  LW
  RW
  CF
  ST
  OTHER
}

enum MatchVideoProvider {
  GOOGLE_DRIVE
  YOUTUBE
  EXTERNAL
}

enum MatchVideoType {
  FULL_MATCH
  FIRST_HALF
  SECOND_HALF
  OTHER
}

enum LineupPlanStatus {
  ACTIVE
  ARCHIVED
}

enum LineupPitchType {
  FULL
  HALF
  SMALL
}

enum TacticCategory {
  ATTACK
  DEFENCE
  TRANSITION
  PRESSING
  BUILD_UP
  SET_PIECE
  TRAINING
  CUSTOM
}

enum TacticVisibility {
  PRIVATE
  COACHING_STAFF
  TEAM_MEMBERS
  PUBLIC
}

enum TacticStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TacticActionType {
  MOVE
  RUN
  SPRINT
  DRIBBLE
  PASS
  CROSS
  SHOT
  PRESS
  HOLD_POSITION
  CUSTOM
}

enum TacticEasing {
  LINEAR
  EASE_IN
  EASE_OUT
  EASE_IN_OUT
}

enum TacticBallActionType {
  MOVE
  PASS
  CROSS
  DRIBBLE
  SHOT
  FREE
}

enum TacticAnnotationType {
  ARROW
  TEXT
  ZONE
  CIRCLE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum PostVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum ConversationType {
  DIRECT
  TEAM
  MATCH
  CLUB
}

enum NotificationType {
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  POST_REPOST
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  MESSAGE
  MATCH_INVITATION_RECEIVED
  MATCH_INVITATION_ACCEPTED
  MATCH_INVITATION_REJECTED
  MATCH_CANCELLED
  MATCH_PLAYER_INVITED
  MATCH_ATTENDANCE_UPDATED
  MATCH_RESULT_SUBMITTED
  MATCH_RESULT_CONFIRMED
  MATCH_RESULT_DISPUTED
  MATCH_COMPLETED
}

enum FeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                      String                 @id @default(cuid())
  name                    String?
  email                   String?                @unique
  emailVerified           DateTime?
  passwordHash            String?
  image                   String?
  coverImage              String?
  username                String?                @unique
  bio                     String?
  favoriteClub            String?
  preferredPosition       String?
  avoidedPosition         String?
  location                String?
  locale                  AppLocale              @default(AZ)
  profileVisibility       ProfileVisibility      @default(PUBLIC)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  isBanned                Boolean                @default(false)
  bannedAt                DateTime?
  banReason               String?
  posts                   Post[]
  comments                Comment[]
  likes                   PostLike[]
  following               Follow[]               @relation("Following")
  followers               Follow[]               @relation("Followers")
  sentFriendRequests      Friendship[]           @relation("FriendshipRequester")
  receivedFriendRequests  Friendship[]           @relation("FriendshipAddressee")
  blockedUsers            Block[]                @relation("Blocker")
  blockedByUsers          Block[]                @relation("Blocked")
  encryptedProfile        UserEncryptedProfile?
  conversationMemberships ConversationMember[]
  sentMessages            Message[]              @relation("MessageSender")
  receivedNotifications   Notification[]         @relation("NotificationRecipient")
  actedNotifications      Notification[]         @relation("NotificationActor")
  favoriteTeams           UserFavoriteTeam[]
  ownedTeams              Team[]
  teamMemberships         TeamMember[]
  ownedClubs              Club[]                 @relation("ClubOwner")
  deactivatedClubs        Club[]                 @relation("ClubDeactivatedBy")
  clubMemberships         ClubMember[]           @relation("ClubMemberUser")
  clubInvitesSent         ClubMember[]           @relation("ClubMemberInviter")
  clubGuestsCreated       ClubGuest[]            @relation("ClubGuestCreator")
  clubMetricDefinitions   ClubMetricDefinition[] @relation("ClubMetricCreator")
  createdMatches          Match[]                @relation("MatchCreatedBy")
  submittedMatchResults   Match[]                @relation("MatchResultSubmittedBy")
  confirmedMatchResults   Match[]                @relation("MatchResultConfirmedBy")
  matchPlayers            MatchPlayer[]          @relation("MatchPlayerUser")
  matchPlayerInvites      MatchPlayer[]          @relation("MatchPlayerInviter")
  matchVideos             MatchVideo[]           @relation("MatchVideoUploader")
  matchComments           MatchComment[]         @relation("MatchCommentAuthor")
  lineupPlansCreated      LineupPlan[]            @relation("LineupPlanCreator")
  tacticsCreated          Tactic[]                @relation("TacticCreator")
  matchTacticsAttached    MatchTactic[]           @relation("MatchTacticAttacher")
  playerStats             PlayerStats?
  accounts                Account[]
  sessions                Session[]
  feedbacks               Feedback[]
  submittedPostReports    PostReport[]           @relation("PostReportReporter")
  receivedPostReports     PostReport[]           @relation("PostReportAuthor")
}

model UserFavoriteTeam {
  id         String   @id @default(cuid())
  userId     String
  externalId String?
  name       String
  country    String?
  league     String?
  logoUrl    String?
  badgeUrl   String?
  source     String   @default("thesportsdb")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId])
  @@index([name])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Feedback {
  id         String         @id @default(cuid())
  userId     String
  message    String
  status     FeedbackStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  resolvedAt DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model UserEncryptedProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  ciphertext String
  iv         String
  algorithm  String   @default("AES-GCM")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id             String         @id @default(cuid())
  authorId       String
  content        String?
  visibility     PostVisibility @default(PUBLIC)
  originalPostId String?
  repostNote     String?
  ciphertext     String?
  iv             String?
  algorithm      String?        @default("AES-GCM")
  keyVersion     Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isHidden       Boolean        @default(false)
  hiddenAt       DateTime?
  moderationNote String?
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  originalPost   Post?          @relation("PostReposts", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts        Post[]         @relation("PostReposts")
  media          PostMedia[]
  comments       Comment[]
  likes          PostLike[]
  notifications  Notification[]
  reports        PostReport[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([originalPostId])
  @@index([visibility])
  @@index([isHidden, createdAt])
}

model PostReport {
  id           String       @id @default(cuid())
  postId       String
  reporterId   String
  postAuthorId String
  note         String
  status       ReportStatus @default(OPEN)
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resolvedAt   DateTime?
  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter     User         @relation("PostReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  postAuthor   User         @relation("PostReportAuthor", fields: [postAuthorId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([status, createdAt])
  @@index([postAuthorId, createdAt])
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  type      MediaType
  url       String
  publicId  String
  width     Int?
  height    Int?
  duration  Float?
  format    String?
  size      Int?
  order     Int
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, order])
  @@index([postId])
}

model Comment {
  id            String         @id @default(cuid())
  postId        String
  authorId      String
  parentId      String?
  content       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("CommentReplies")
  notifications Notification[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Friendship {
  id            String           @id @default(cuid())
  requesterId   String
  addresseeId   String
  status        FriendshipStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  acceptedAt    DateTime?
  requester     User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee     User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Conversation {
  id            String               @id @default(cuid())
  type          ConversationType
  clubId        String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       ConversationMember[]
  messages      Message[]
  notifications Notification[]
  club          Club?                @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model ConversationMember {
  id                       String       @id @default(cuid())
  conversationId           String
  userId                   String
  encryptedConversationKey String
  keyVersion               Int          @default(1)
  joinedAt                 DateTime     @default(now())
  lastReadAt               DateTime?
  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  senderId       String
  ciphertext     String
  iv             String
  authTag        String
  algorithm      String         @default("aes-256-gcm")
  keyVersion     Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User           @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  actorId        String?
  type           NotificationType
  postId         String?
  commentId      String?
  conversationId String?
  messageId      String?
  friendshipId   String?
  matchId        String?
  title          String?
  body           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  recipient      User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post           Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment        Comment?         @relation(fields: [commentId], references: [id], onDelete: SetNull)
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  friendship     Friendship?      @relation(fields: [friendshipId], references: [id], onDelete: SetNull)
  match          Match?           @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([actorId])
  @@index([postId])
  @@index([commentId])
  @@index([conversationId])
  @@index([matchId])
  @@index([type])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String
  logoUrl     String?
  ownerId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]

  @@index([ownerId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  position String?
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Club {
  id                String                 @id @default(cuid())
  name              String
  slug              String                 @unique
  description       String?
  logoUrl           String?
  logoPublicId      String?
  coverUrl          String?
  coverPublicId     String?
  country           String?
  city              String?
  ownerId           String
  visibility        ClubVisibility         @default(REQUEST_ONLY)
  isActive          Boolean                @default(true)
  deactivatedAt     DateTime?
  deactivatedById   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  owner             User                   @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  deactivatedBy     User?                  @relation("ClubDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull)
  settings          ClubSettings?
  members           ClubMember[]
  guests            ClubGuest[]
  metricDefinitions ClubMetricDefinition[]
  conversation      Conversation?
  createdMatches    Match[]                @relation("MatchCreatorClub")
  homeMatches       Match[]                @relation("MatchHomeClub")
  awayMatches       Match[]                @relation("MatchAwayClub")
  submittedResults  Match[]                @relation("MatchResultSubmittedByClub")
  reviewedResults   Match[]                @relation("MatchResultReviewedByClub")
  matchSides        MatchSide[]
  stats             ClubStats?
  lineupPlans       LineupPlan[]
  tactics           Tactic[]
  matchTactics      MatchTactic[]

  @@index([ownerId])
  @@index([isActive])
}

model ClubSettings {
  id                          String               @id @default(cuid())
  clubId                      String               @unique
  joinApprovalPolicy          ClubPermissionPolicy @default(OWNER_TD)
  invitePermissionPolicy      ClubPermissionPolicy @default(OWNER_TD)
  matchCreatePermissionPolicy ClubPermissionPolicy @default(OWNER_TD)
  guestInvitePolicy           GuestInvitePolicy    @default(ONLY_OWNER_TD_YTD)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  club                        Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model ClubMember {
  id          String           @id @default(cuid())
  clubId      String
  userId      String
  role        ClubRole         @default(PLAYER)
  status      ClubMemberStatus @default(REQUESTED)
  invitedById String?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  club        Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User             @relation("ClubMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?            @relation("ClubMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  lineupSlots LineupSlot[]

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@index([clubId, role])
  @@index([clubId, status])
}

model ClubGuest {
  id           String            @id @default(cuid())
  clubId       String
  fullName     String
  position     FootballPosition?
  phone        String?
  note         String?
  createdById  String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  club         Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ClubGuestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  matchPlayers MatchPlayer[]

  @@index([clubId])
}

model ClubMetricDefinition {
  id          String   @id @default(cuid())
  clubId      String
  name        String
  description String?
  order       Int
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ClubMetricCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clubId])
  @@index([clubId, isActive])
}

model Match {
  id                      String                   @id @default(cuid())
  type                    MatchType
  source                  MatchSource              @default(MANUAL)
  format                  MatchFormat?
  category                MatchCategory            @default(FRIENDLY)
  status                  MatchStatus              @default(DRAFT)
  creatorClubId           String
  homeClubId              String?
  awayClubId              String?
  title                   String?
  venue                   String?
  note                    String?
  startTime               DateTime
  endTime                 DateTime?
  durationMinutes         Int?
  homeScore               Int?
  awayScore               Int?
  resultNote              String?
  resultSubmittedById     String?
  resultSubmittedByClubId String?
  resultSubmittedAt       DateTime?
  resultConfirmedById     String?
  resultReviewedByClubId  String?
  resultConfirmedAt       DateTime?
  alternativeHomeScore    Int?
  alternativeAwayScore    Int?
  rejectionReason         String?
  cancellationReason      MatchCancellationReason?
  cancellationNote        String?
  disputeReason           String?
  adminDecisionNote       String?
  completedAt             DateTime?
  statsAppliedAt          DateTime?
  createdById             String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  creatorClub             Club                     @relation("MatchCreatorClub", fields: [creatorClubId], references: [id], onDelete: Restrict)
  homeClub                Club?                    @relation("MatchHomeClub", fields: [homeClubId], references: [id], onDelete: Restrict)
  awayClub                Club?                    @relation("MatchAwayClub", fields: [awayClubId], references: [id], onDelete: Restrict)
  createdBy               User                     @relation("MatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resultSubmittedBy       User?                    @relation("MatchResultSubmittedBy", fields: [resultSubmittedById], references: [id], onDelete: SetNull)
  resultConfirmedBy       User?                    @relation("MatchResultConfirmedBy", fields: [resultConfirmedById], references: [id], onDelete: SetNull)
  resultSubmittedByClub   Club?                    @relation("MatchResultSubmittedByClub", fields: [resultSubmittedByClubId], references: [id], onDelete: Restrict)
  resultReviewedByClub    Club?                    @relation("MatchResultReviewedByClub", fields: [resultReviewedByClubId], references: [id], onDelete: Restrict)
  sides                   MatchSide[]
  players                 MatchPlayer[]
  videos                  MatchVideo[]
  goals                   MatchGoal[]
  comments                MatchComment[]
  notifications           Notification[]
  tactics                 MatchTactic[]

  @@index([creatorClubId])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([status])
  @@index([startTime])
  @@index([resultSubmittedByClubId])
}

model MatchSide {
  id        String        @id @default(cuid())
  matchId   String
  clubId    String?
  name      String
  side      MatchSideType
  score     Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  club      Club?         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  players   MatchPlayer[]
  goals     MatchGoal[]

  @@unique([matchId, side])
  @@index([matchId])
}

model MatchPlayer {
  id           String            @id @default(cuid())
  matchId      String
  matchSideId  String
  userId       String?
  clubGuestId  String?
  guestName    String?
  position     FootballPosition?
  shirtNumber  Int?
  status       MatchPlayerStatus @default(SELECTED)
  lineupRole   MatchLineupRole   @default(SUBSTITUTE)
  isCaptain    Boolean           @default(false)
  isGoalkeeper Boolean           @default(false)
  invitedById  String?
  acceptedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  match        Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchSide    MatchSide         @relation(fields: [matchSideId], references: [id], onDelete: Cascade)
  user         User?             @relation("MatchPlayerUser", fields: [userId], references: [id], onDelete: Restrict)
  clubGuest    ClubGuest?        @relation(fields: [clubGuestId], references: [id], onDelete: Restrict)
  invitedBy    User?             @relation("MatchPlayerInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  goals        MatchGoal[]

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([matchSideId])
  @@index([userId])
  @@index([clubGuestId])
}

model ClubStats {
  id             String   @id @default(cuid())
  clubId         String   @unique
  matchesPlayed  Int      @default(0)
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  goalDifference Int      @default(0)
  recentForm     Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model MatchVideo {
  id               String             @id @default(cuid())
  matchId          String
  originalUrl      String
  embedUrl         String
  provider         MatchVideoProvider
  videoType        MatchVideoType     @default(FULL_MATCH)
  matchStartSecond Int                @default(0)
  publicId         String?
  title            String?
  description      String?
  uploadedById     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  match            Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  uploadedBy       User               @relation("MatchVideoUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([matchId])
}

model MatchGoal {
  id            String       @id @default(cuid())
  matchId       String
  matchSideId   String
  matchPlayerId String?
  playerName    String
  minute        Int?
  extraMinute   Int?
  createdAt     DateTime     @default(now())
  match         Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchSide     MatchSide    @relation(fields: [matchSideId], references: [id], onDelete: Cascade)
  matchPlayer   MatchPlayer? @relation(fields: [matchPlayerId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([matchSideId])
}

model MatchComment {
  id        String         @id @default(cuid())
  matchId   String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  match     Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  author    User           @relation("MatchCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    MatchComment?  @relation("MatchCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   MatchComment[] @relation("MatchCommentReplies")

  @@index([matchId, createdAt])
  @@index([parentId])
}

model LineupPlan {
  id            String           @id @default(cuid())
  clubId        String
  name          String
  description   String?
  playerCount   Int
  formationCode String
  pitchType     LineupPitchType  @default(FULL)
  status        LineupPlanStatus @default(ACTIVE)
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  club          Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy     User             @relation("LineupPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  slots         LineupSlot[]
  tactics       Tactic[]

  @@index([clubId, status, updatedAt])
  @@unique([clubId, name])
}

model LineupSlot {
  id                   String           @id @default(cuid())
  lineupPlanId         String
  slotKey              String
  label                String
  position             FootballPosition?
  x                    Float
  y                    Float
  assignedClubMemberId String?
  shirtNumber          Int?
  isCaptain            Boolean          @default(false)
  isGoalkeeper         Boolean          @default(false)
  isSubstitute         Boolean          @default(false)
  sortOrder            Int
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lineupPlan           LineupPlan       @relation(fields: [lineupPlanId], references: [id], onDelete: Cascade)
  assignedClubMember   ClubMember?      @relation(fields: [assignedClubMemberId], references: [id], onDelete: SetNull)

  @@unique([lineupPlanId, slotKey])
  @@unique([lineupPlanId, assignedClubMemberId])
  @@index([lineupPlanId, sortOrder])
  @@index([assignedClubMemberId])
}

model Tactic {
  id            String           @id @default(cuid())
  clubId        String
  lineupPlanId  String
  name          String
  description   String?
  category      TacticCategory
  visibility    TacticVisibility @default(COACHING_STAFF)
  durationMs    Int              @default(10000)
  status        TacticStatus     @default(DRAFT)
  snapshotData  Json
  previewData   Json?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  club          Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  lineupPlan    LineupPlan       @relation(fields: [lineupPlanId], references: [id], onDelete: Restrict)
  createdBy     User             @relation("TacticCreator", fields: [createdById], references: [id], onDelete: Restrict)
  scenes        TacticScene[]
  matches       MatchTactic[]

  @@index([clubId, status, updatedAt])
  @@index([lineupPlanId, status])
}

model TacticScene {
  id             String   @id @default(cuid())
  tacticId       String
  name           String
  description    String?
  sortOrder      Int
  durationMs     Int      @default(2000)
  startState     Json
  endState       Json
  ballStartState Json?
  ballEndState   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tactic         Tactic   @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  playerActions  TacticPlayerAction[]
  ballActions    TacticBallAction[]
  annotations    TacticAnnotation[]

  @@unique([tacticId, sortOrder])
  @@index([tacticId, sortOrder])
}

model TacticPlayerAction {
  id          String           @id @default(cuid())
  sceneId     String
  slotKey     String
  type        TacticActionType
  targetSlotKey String?
  startX      Float
  startY      Float
  endX        Float
  endY        Float
  startTimeMs Int
  durationMs  Int
  easing      TacticEasing     @default(LINEAR)
  label       String?
  note        String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  scene       TacticScene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId, startTimeMs])
  @@index([sceneId, slotKey])
}

model TacticBallAction {
  id            String               @id @default(cuid())
  sceneId       String
  type          TacticBallActionType
  sourceSlotKey String?
  targetSlotKey String?
  startX        Float
  startY        Float
  endX          Float
  endY          Float
  startTimeMs   Int
  durationMs    Int
  easing        TacticEasing         @default(LINEAR)
  metadata      Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  scene         TacticScene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId, startTimeMs])
}

model TacticAnnotation {
  id          String               @id @default(cuid())
  sceneId     String
  type        TacticAnnotationType
  x           Float
  y           Float
  width       Float?
  height      Float?
  rotation    Float                @default(0)
  label       String?
  description String?
  startTimeMs Int                  @default(0)
  durationMs  Int?
  metadata    Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  scene       TacticScene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId, startTimeMs])
}

model MatchTactic {
  id           String   @id @default(cuid())
  matchId      String
  tacticId     String
  clubId       String
  attachedById String
  createdAt    DateTime @default(now())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tactic       Tactic   @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  attachedBy   User     @relation("MatchTacticAttacher", fields: [attachedById], references: [id], onDelete: Restrict)

  @@unique([matchId, tacticId])
  @@index([clubId, matchId])
}

model PlayerStats {
  id            String   @id @default(cuid())
  userId        String   @unique
  matchesPlayed Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  preferredFoot String?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
